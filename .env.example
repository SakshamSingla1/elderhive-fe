# Copy to .env.local to override. Vite only exposes env vars prefixed VITE_ to client code.
# Not yet consumed by any code (the axios client lands in Phase 4) - this just establishes
# the variable name/convention now so that phase can pick it up directly.

VITE_API_BASE_URL=http://localhost:8080

# Stripe's publishable key (safe to expose client-side, unlike the backend's secret key).
# Blank by default -> getStripe() (utils/stripeClient.ts) resolves to null and
# CheckoutPaymentForm renders nothing rather than crashing - payments are additive
# (Prompt 97's own documented choice), so the rest of the app works with zero Stripe setup.
VITE_STRIPE_PUBLISHABLE_KEY=
